{
  "manifest_version": 3,
  "name": "DomainSentary",
  "version": "1.0.0",
  "description": "Detect potentially suspicious and phishing websites.",
  
  "permissions": [
    "activeTab",
    "tabs"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  }
}